ALTER DATABASE filmbookcatalog CHARACTER SET = utf8mb4 COLLATE = utf8mb4_unicode_ci;

-- Промени кодирането на таблицата Movies
ALTER TABLE Movies CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

-- Промени кодирането на таблицата Books
ALTER TABLE Books CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

-- Промени кодирането на таблицата Ratings
ALTER TABLE Ratings CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

-- Промени кодирането на таблицата Users
ALTER TABLE Users CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

-- Използвай базата данни
USE filmbookcatalog;

SET FOREIGN_KEY_CHECKS = 0;
TRUNCATE TABLE Ratings;
TRUNCATE TABLE Books;
TRUNCATE TABLE Movies;
TRUNCATE TABLE Users;
SET FOREIGN_KEY_CHECKS = 1;


