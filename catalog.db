-- 3. ДОБАВЯНЕ НА ФИЛМИ
INSERT INTO Movies (Title, Director, Year, Description, ImageUrl, CreatedAt) VALUES
('The Shawshank Redemption', 'Frank Darabont', 1994, 'Двама затворници създават приятелство в продължение на много години, намирайки утеха и изкупление чрез актове на достойнство.', 'https://m.media-amazon.com/images/M/MV5BNDE3ODcxYzMtY2YzZC00NmNlLWJiNDMtYTViYWU4NjdjMmQ2XkEyXkFqcGdeQXVyNjUwNzk3NDc@._V1_.jpg', NOW()),
('The Godfather', 'Francis Ford Coppola', 1972, 'Патриархът на мафиотска династия прехвърля контрола на своя неохотен син.', 'https://m.media-amazon.com/images/M/MV5BM2MyNjYxNmUtYTAwNi00MTYxLWJmNWYtYzZlODY3ZTk3OTFlXkEyXkFqcGdeQXVyNzkwMjQ5NzM@._V1_.jpg', NOW()),
('Pulp Fiction', 'Quentin Tarantino', 1994, 'Животът на двама убийци, боксьор, гангстер и чифт обирджии се преплита в четири истории за насилие и изкупление.', 'https://m.media-amazon.com/images/M/MV5BNGNhMDIzZTUtNTBlZi00MTRlLWFjM2ItYzViMjE3YzI5MjljXkEyXkFqcGdeQXVyNzkwMjQ5NzM@._V1_.jpg', NOW()),
('The Dark Knight', 'Christopher Nolan', 2008, 'Батман поема риска да изправи закона срещу Жокера, престъпен гений, който иска да разруши Готъм.', 'https://m.media-amazon.com/images/M/MV5BMTMxNTMwODM0NF5BMl5BanBnXkFtZTcwODAyMTk2Mw@@._V1_.jpg', NOW()),
('Forrest Gump', 'Robert Zemeckis', 1994, 'Историята на човек с увреждания, който присъства на някои от най-важните събития в американската история.', 'https://m.media-amazon.com/images/M/MV5BNWIwODRlZTUtY2U3ZS00Yzg1LWJhNzYtMmZiYmEyNmU1NjMzXkEyXkFqcGdeQXVyMTQxNzMzNDI@._V1_.jpg', NOW()),
('Inception', 'Christopher Nolan', 2010, 'Крадец, който краде корпоративни тайни чрез технология за споделяне на сънища, получава обратната задача да вмъкне идея в ума на главен изпълнителен директор.', 'https://m.media-amazon.com/images/M/MV5BMjAxMzY3NjcxNF5BMl5BanBnXkFtZTcwNTI5OTM0Mw@@._V1_.jpg', NOW()),
('The Matrix', 'Lana Wachowski, Lilly Wachowski', 1999, 'Хакер научава от мистериозни бунтовници за истинската природа на реалността и ролята си във войната срещу нейните контролери.', 'https://m.media-amazon.com/images/M/MV5BNzQzOTk3OTAtNDQ0Zi00ZTVkLWI0MTEtMDllZjNkYzNjNTc4L2ltYWdlXkEyXkFqcGdeQXVyNjU0OTQ0OTY@._V1_.jpg', NOW()),
('Goodfellas', 'Martin Scorsese', 1990, 'Историята на Хенри Хил и живота му в мафията, разказваща годините му от детството до престъпната кариера.', 'https://m.media-amazon.com/images/M/MV5BY2NkZjEzMDgtN2RjYy00YzM1LWI4ZmQtMjIwYjFjNmI3ZGEwXkEyXkFqcGdeQXVyNzkwMjQ5NzM@._V1_.jpg', NOW()),
('Fight Club', 'David Fincher', 1999, 'Офис служител и производител на сапун създават подземен боен клуб, който прераства в нещо много по-голямо.', 'https://m.media-amazon.com/images/M/MV5BMmEzNTk2YzgtNjMzZS00NzY1LWJlOTMtZTA4Y2U4M2VkYzliXkEyXkFqcGdeQXVyNzkwMjQ5NzM@._V1_.jpg', NOW()),
('The Lord of the Rings: The Fellowship of the Ring', 'Peter Jackson', 2001, 'Скромен хобит от Шир и осем спътника тръгват на мисия да унищожат могъщия Единствен пръстен и да спасят Средната земя.', 'https://m.media-amazon.com/images/M/MV5BN2EyZjM3NzUtNWUzMi00MTgxLWI0NTctMzY4M2VlOTdjZWRiXkEyXkFqcGdeQXVyNDUzOTQ5MjY@._V1_.jpg', NOW());


