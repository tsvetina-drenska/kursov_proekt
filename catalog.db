-- 6. ПРОВЕРКА НА ДАННИТЕ
SELECT 'Потребители:' AS 'Таблица', COUNT(*) AS 'Брой' FROM Users
UNION ALL
SELECT 'Филми:', COUNT(*) FROM Movies
UNION ALL
SELECT 'Книги:', COUNT(*) FROM Books
UNION ALL
SELECT 'Оценки:', COUNT(*) FROM Ratings;

