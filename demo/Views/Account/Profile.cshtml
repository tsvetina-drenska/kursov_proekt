@model catalog.Models.UserDto
@{
    ViewData["Title"] = "Моят профил";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-id-card me-2"></i> Моят профил
                    </h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-user-circle fa-5x text-secondary"></i>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Потребителско име</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Username</dd>

                        <dt class="col-sm-4 text-muted">Имейл</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Email) ? "не е въведен" : Model.Email)</dd>

                        <dt class="col-sm-4 text-muted">Регистриран на</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</dd>
                    </dl>
                </div>
                <div class="card-footer text-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Обратно към началната страница
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
